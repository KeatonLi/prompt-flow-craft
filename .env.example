# ============================================
# Prompt Flow Craft 环境变量模板
# 用法：cp .env.example .env 并填入真实值（.env 已加入 .gitignore，勿提交）
# ============================================

# ---- LLM 模型服务 ----
LLM_AUTH_TOKEN=sk-xxxx                                  # 必填，无默认值
LLM_BASE_URL=https://api.deepseek.com                    # 可选，默认 dashscope
LLM_MODEL=DeepSeek-V4-Flash                              # 可选，默认 qwen-turbo-2025-07-15

# ---- 数据库（必填，无默认值）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alphapick
DB_USERNAME=root
DB_PASSWORD=your_password

# ---- 可选（均有默认值，按需覆盖）----
# SERVER_PORT=80
# DB_TIMEZONE=Asia/Shanghai
# TEMPERATURE=0.7
# MAX_TOKENS=2000
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_PROMPTFLOW=DEBUG
# LOG_LEVEL_SPRING_AI=DEBUG
